#!/usr/bin/env python3
"""dum — daily update mail.

    dum        create today's update note and open it in Obsidian
    dum -d     turn today's note into an Outlook draft and open it

Both commands work inside one folder per day,
"7 - updates/daily_updates/daily_update_<date>/", holding the markdown note you
write and the .emltpl draft built from it. An existing note is never rewritten.
"""

import mimetypes
import re
import subprocess
import sys
import urllib.parse
from datetime import date
from email import policy
from email.message import EmailMessage
from email.utils import formatdate, make_msgid
from pathlib import Path

# ============ EDIT THESE ============
VAULT = Path("/Users/oruc/Desktop/bfi2b")
VAULT_NAME = "bfi2b"                                  # the name Obsidian shows
UPDATES = VAULT / "7 - updates" / "daily_updates"
TO = "Ali Hortacsu <hortacsu@gmail.com>, Ali Hortacsu <hortacsu@uchicago.edu>"
CC = ""
# ====================================

# the Outlook body style, copied from the template Ikbal has been sending
STYLE = ("direction: ltr; font-family: Verdana, Arial, Helvetica, sans-serif; "
         "font-size: 11pt; color: rgb(0, 0, 0);")

# Outlook's own marker for each nesting level, and the gap after a top-level item
MARKERS = ["disc", "circle", "square"]
TOP_ITEM_GAP = "0.6em"


def subject_for(day):
    """The subject line, e.g. "[Update] Wednesday, September 16"."""
    return "[Update] {}, {} {}".format(
        day.strftime("%A"), day.strftime("%B"), day.day)


def note_path(day):
    folder = UPDATES / "daily_update_{}".format(day.isoformat())
    return folder / "daily_update_{}.md".format(day.isoformat())


def blank_note(day):
    """The markdown a new day starts from."""
    return """---
to: {to}
cc: {cc}
subject: "{subject}"
date: {day}
---

Merhaba Hocam,

**What I did Today:**

-

**What I will do tomorrow:**

-

**Questions for Ali Hoca (y/n)?**

n

—
Ikbal
""".format(to=TO, cc=CC, subject=subject_for(day), day=day.isoformat())


# ---------- reading the note back ----------

def split_note(text):
    """Return the frontmatter as a dict and the body as a list of lines."""
    lines = text.splitlines()
    if lines[0].strip() != "---":
        sys.exit("the note has no frontmatter; the first line must be ---")

    end = lines.index("---", 1)
    fields = {}
    for line in lines[1:end]:
        if ":" in line:
            name, value = line.split(":", 1)
            fields[name.strip().lower()] = value.strip().strip('"')

    body = lines[end + 1:]
    while body and not body[0].strip():
        body.pop(0)
    return fields, body


# ---------- bullets ----------

def is_bullet(line):
    return line.lstrip().startswith(("- ", "* ")) or line.strip() in ("-", "*")


def bullet_text(line):
    return line.lstrip()[1:].strip()


def indent_width(line):
    """How far a line is indented, counting a tab as four spaces."""
    text = line.replace("\t", "    ")
    return len(text) - len(text.lstrip())


def bullet_levels(body):
    """The nesting level of each line, or -1 where the line is not a bullet.

    The levels come from the order of the indents rather than their size, so
    tabs, two spaces and four spaces all nest the same way.
    """
    levels = []
    open_indents = []
    for line in body:
        if not is_bullet(line):
            levels.append(-1)
            if line.strip():            # blank lines inside a list are spacing
                open_indents = []
            continue

        width = indent_width(line)
        while open_indents and width < open_indents[-1]:
            open_indents.pop()
        if not open_indents or width > open_indents[-1]:
            open_indents.append(width)
        levels.append(len(open_indents) - 1)
    return levels


# ---------- images ----------

IMAGE_LINE = re.compile(r"^\s*!\[\[(?P<wiki>[^\]]+)\]\]\s*$"
                        r"|^\s*!\[[^\]]*\]\((?P<path>[^)]+)\)\s*$")


def image_in_line(line):
    """The file an image line points at, or None if the line is not one."""
    found = IMAGE_LINE.match(line)
    if found is None:
        return None
    return found.group("wiki") or found.group("path")


def find_image(name, note_folder):
    """Where an embedded image actually lives."""
    name = name.split("|")[0].strip()          # Obsidian allows ![[file.png|300]]
    direct = Path(name)
    if direct.is_absolute() and direct.exists():
        return direct
    beside = note_folder / name
    if beside.exists():
        return beside
    matches = sorted(VAULT.rglob(Path(name).name))
    if matches:
        return matches[0]
    return None


# ---------- markdown to the two bodies ----------

def inline_html(text):
    """Bold, italic, code and links, with the HTML specials escaped first."""
    text = text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    text = re.sub(r"\[(.+?)\]\((.+?)\)", r'<a href="\2">\1</a>', text)
    text = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", text)
    text = re.sub(r"(?<!\*)\*([^*]+)\*(?!\*)", r"<i>\1</i>", text)
    text = re.sub(r"`(.+?)`", r'<span style="font-family: monospace;">\1</span>', text)
    return text


def inline_plain(text):
    """The same line with the markers taken out, for the plain text part."""
    text = re.sub(r"\[(.+?)\]\((.+?)\)", r"\1 (\2)", text)
    text = text.replace("**", "").replace("`", "")
    text = re.sub(r"(?<!\*)\*([^*]+)\*(?!\*)", r"\1", text)
    return text


def list_open(level):
    marker = MARKERS[level % len(MARKERS)]
    if level == 0:
        return '<ul style="{} list-style-type: {};">'.format(STYLE, marker)
    return '<ul style="list-style-type: {};">'.format(marker)


def item_open(level):
    if level == 0:
        return '<li style="margin-bottom: {};">'.format(TOP_ITEM_GAP)
    return "<li>"


def body_to_html(body, images):
    """The body as the nested lists and divs Outlook renders.

    A nested list is opened inside the item above it, which is what makes
    Outlook show the levels the way Obsidian does, with its own disc, circle
    and square markers.
    """
    levels = bullet_levels(body)
    parts = ["<html>", "<head>",
             '<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">',
             "</head>", "<body>"]
    depth = 0                       # how many lists are open

    for line, level in zip(body, levels):
        if level >= 0:
            if not bullet_text(line):        # an unfilled "-" from the template
                continue
            while depth > level + 1:
                parts += ["</li>", "</ul>"]
                depth -= 1
            if depth == level + 1:
                parts.append("</li>")
            while depth < level + 1:
                parts.append(list_open(depth))
                depth += 1
            parts.append(item_open(level) + inline_html(bullet_text(line)))
            continue

        if depth and not line.strip():       # spacing inside a list
            continue
        while depth:
            parts += ["</li>", "</ul>"]
            depth -= 1

        image = image_in_line(line)
        if image is not None:
            parts.append(image_html(image, images))
        elif not line.strip():
            parts.append('<div style="{}"><br></div>'.format(STYLE))
        else:
            parts.append('<div style="{}">{}</div>'.format(STYLE, inline_html(line)))

    while depth:
        parts += ["</li>", "</ul>"]
        depth -= 1
    parts += ["</body>", "</html>"]
    return "\n".join(parts)


def image_html(name, images):
    """The <img> for an embedded image, remembering it so it can be attached."""
    if name.startswith(("http://", "https://")):
        return '<div style="{}"><img src="{}" style="max-width: 100%;"></div>'.format(
            STYLE, name)

    found = find_image(name, images["folder"])
    if found is None:
        print("could not find the image", name, "- it was left out of the email")
        return '<div style="{}">[missing image: {}]</div>'.format(STYLE, name)

    cid = make_msgid()
    images["files"].append((cid, found))
    return ('<div style="{}"><img src="cid:{}" style="max-width: 100%;"></div>'
            .format(STYLE, cid[1:-1]))


def body_to_plain(body):
    levels = bullet_levels(body)
    lines = []
    for line, level in zip(body, levels):
        if level >= 0:
            if bullet_text(line):
                lines.append("  " * level + "- " + inline_plain(bullet_text(line)))
            continue
        image = image_in_line(line)
        if image is not None:
            lines.append("[image: {}]".format(Path(image.split("|")[0]).name))
        else:
            lines.append(inline_plain(line))
    return "\n".join(lines) + "\n"


# ---------- the draft ----------

def build_draft(fields, body, note_folder):
    images = {"folder": note_folder, "files": []}
    html = body_to_html(body, images)

    mail = EmailMessage(policy=policy.SMTP)
    mail["To"] = fields.get("to") or TO
    if fields.get("cc"):
        mail["Cc"] = fields["cc"]
    mail["Subject"] = fields["subject"]
    mail["Date"] = formatdate(localtime=True)
    mail["X-Unsent"] = "1"          # Outlook opens it as a draft, not as mail received
    mail.set_content(body_to_plain(body), subtype="plain", charset="utf-8",
                     cte="quoted-printable")
    mail.add_alternative(html, subtype="html", charset="utf-8",
                         cte="quoted-printable")

    html_part = mail.get_payload()[1]
    for cid, path in images["files"]:
        kind, _ = mimetypes.guess_type(path.name)
        maintype, subtype = kind.split("/") if kind else ("application", "octet-stream")
        html_part.add_related(path.read_bytes(), maintype=maintype, subtype=subtype,
                              cid=cid, filename=path.name)
    return mail, [path for _, path in images["files"]]


# ---------- the two commands ----------

def open_in_obsidian(path):
    inside_vault = path.relative_to(VAULT)
    uri = "obsidian://open?vault={}&file={}".format(
        urllib.parse.quote(VAULT_NAME), urllib.parse.quote(str(inside_vault)))
    subprocess.run(["open", uri], check=True)


def start_today(day):
    note = note_path(day)
    if note.exists():
        print("today's note is already there:", note)
    else:
        note.parent.mkdir(parents=True, exist_ok=True)
        note.write_text(blank_note(day), encoding="utf-8")
        print("wrote", note)
        print("subject:", subject_for(day))
    open_in_obsidian(note)


def finish_today(day):
    note = note_path(day)
    if not note.exists():
        sys.exit("no note for {} yet — run dum first".format(day.isoformat()))

    fields, body = split_note(note.read_text(encoding="utf-8"))
    draft, attached = build_draft(fields, body, note.parent)
    out = note.parent / "{}.emltpl".format(fields["subject"])
    out.write_bytes(bytes(draft))

    print("wrote", out)
    print("to:", draft["To"])
    print("subject:", draft["Subject"])
    for path in attached:
        print("embedded:", path.name)
    print("opening it in Outlook — read it there and send.")
    subprocess.run(["open", str(out)], check=True)


if __name__ == "__main__":
    args = sys.argv[1:]
    if not args:
        start_today(date.today())
    elif args[0] in ("-d", "--done"):
        finish_today(date.today())
    else:
        sys.exit(__doc__)
